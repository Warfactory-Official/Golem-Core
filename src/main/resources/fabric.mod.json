{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}@golem.credits@",
    "contact": {
        "homepage": "@golem.homepage@",
        "sources": "@golem.sources@",
        "issues": "@golem.issues@"
    },
    "authors": [
        "${mod_author}"
    ],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.golem.core.platform.FabricEntrypoint"
        ],
        "client": [
            "dev.golem.core.platform.FabricClientEntrypoint",
            "dev.golem.core.harness.HarnessFabricClient"
        ]
    },
    "mixins": [
        "golemcore.mixins.json",
        "golemcore.fabric.mixins.json",
        "golemcore.harness.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}"
    },
    "breaks": {
        "gemrender": "<0.1.14"
    }
}

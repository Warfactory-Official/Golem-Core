{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.golem.core.platform.FabricEntrypoint"
        ],
        "client": [
            "dev.golem.core.platform.FabricClientEntrypoint",
            "dev.golem.core.harness.HarnessFabricClient"
        ],
        "fabric-gametest": [
            "dev.golem.core.gametest.GolemTestGenerator"
        ]
    },
    "mixins": [
        "golemcore.mixins.json",
        "golemcore.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}"
    }
}
